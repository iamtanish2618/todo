# Private server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Choose a provider whose age, privacy, and app-use rules fit Todo's users.
TODO_AI_API_KEY=
TODO_AI_BASE_URL=
TODO_AI_MODEL=
TODO_AI_LABEL=
# Set true only for a model supporting image input.
TODO_AI_VISION=false
TODO_AI_DAILY_LIMIT=25

# Google/email Todo accounts. Missing Firebase settings fail closed.
# chatgpt is available only as an explicit legacy development option.
TODO_AUTH_PROVIDER=firebase
# Public Firebase web-app settings (not service-account/private-key JSON).
TODO_FIREBASE_API_KEY=
TODO_FIREBASE_PROJECT_ID=
TODO_FIREBASE_AUTH_DOMAIN=
TODO_FIREBASE_APP_ID=

# Temporary Firebase shared tables (existing verified Todo login)
TODO_FIREBASE_DATABASE_URL=
TODO_FEATURE_TABLES=1
TODO_FEATURE_VOICE=1
TODO_FEATURE_BREAK_GAMES=1
# Optional TURN relay; leave blank for STUN-only voice
TODO_TURN_URL=
TODO_TURN_USERNAME=
TODO_TURN_CREDENTIAL=
